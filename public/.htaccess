<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Accesos EXTERNOS con el prefijo del viejo staging (/limaprogramacion/public/*)
    # → 301 a la raíz del dominio. THE_REQUEST conserva la URL original del
    # navegador, así que el tráfico normal (rewrites internos desde el .htaccess
    # raíz) no dispara esta regla. Complementa el 301 de /limaprogramacion/.htaccess.
    RewriteCond %{THE_REQUEST} \s/+limaprogramacion[/?\s]
    RewriteRule ^(.*)$ /$1 [R=301,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    # Destino ABSOLUTO a propósito. La regla que trae Laravel usa `%1` relativo
    # y esta app vive en un subdirectorio (/public_html/limaprogramacion/public)
    # que sirve la raíz del dominio: Apache reconstruía el Location con el path
    # físico, así que /machu-picchu-2-dias-1-noches/ salía a
    # /limaprogramacion/public/machu-picchu-2-dias-1-noches y de ahí rebotaba a
    # la raíz con el 301 de más arriba. Resultado: 3 saltos para una URL vieja
    # (la misma que sin slash resuelve en 1) y la ruta interna del hosting
    # filtrada en un Location público. Con esquema+host explícitos el destino no
    # pasa por el mapeo a filesystem y queda un solo salto.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} ^/(.+)/$
    RewriteRule ^ %{REQUEST_SCHEME}://%{HTTP_HOST}/%1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
